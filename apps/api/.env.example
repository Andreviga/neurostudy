DATABASE_URL="postgresql://user:password@localhost:5432/neurostudy"
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="7d"

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
DEFAULT_AI_PROVIDER="openai"

STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="./uploads"
AWS_BUCKET_NAME=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ─── Cloud Storage (Google Drive + OneDrive) ───────────────────────────────
# Optional — if set, users can connect their own cloud drives.
# AES-256 key (64 hex chars) used to encrypt OAuth tokens at rest.
CLOUD_ENCRYPTION_KEY=""

# Google Drive OAuth — create at https://console.cloud.google.com/
# Scope: https://www.googleapis.com/auth/drive
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/cloud/callback/google"

# OneDrive OAuth — create at https://portal.azure.com/ (App registrations)
# Scopes: files.readwrite.appfolder offline_access
ONEDRIVE_CLIENT_ID=""
ONEDRIVE_CLIENT_SECRET=""
ONEDRIVE_REDIRECT_URI="http://localhost:3001/api/cloud/callback/onedrive"

PORT=3001
WEB_URL="http://localhost:3000"
